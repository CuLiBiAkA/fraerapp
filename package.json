{
  "name": "fraerapp",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "node --check frontend/engine.js && node --check frontend/legal.js && node --check frontend/legal-config.js && node --check scripts/validate-production.mjs",
    "build": "node scripts/validate-production.mjs && node scripts/build-meow.mjs",
    "dev:meow": "python3 -m http.server 8766 --bind 127.0.0.1 --directory frontend",
    "build:meow": "node scripts/build-meow.mjs",
    "test:meow": "node --test frontend/meow/*.test.js && node scripts/check-meow.cjs",
    "test": "node --test frontend/*.test.js frontend/meow/*.test.js story-builder/*.test.js scripts/*.test.mjs",
    "test:ui": "node scripts/run-ui-tests.mjs",
    "test:browser": "node scripts/run-browser-tests.mjs"
  }
}
