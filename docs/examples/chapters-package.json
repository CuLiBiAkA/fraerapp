      "transitions": [{"id": "ticket_to_carriage", "from": {"kind": "scenario", "key": "example_ticket"}, "to": {"kind": "scenario", "key": "example_carriage"}, "stateTransfer": {"mode": "mapped", "contractVersion": 1, "mapping": [{"from": "courage", "to": "initialCourage", "type": "number"}, {"from": "helpedConductor", "to": "metAlly", "type": "boolean"}]}}]
    },
    {"schemaVersion": 1, "key": "example_volume", "type": "volume", "title": "Первый переход", "description": "История с главами и самостоятельный рассказ.", "completionStatus": "completed", "items": [{"target": {"kind": "collection", "key": "example_train"}}, {"target": {"kind": "scenario", "key": "example_keeper"}}], "transitions": []},
    {"schemaVersion": 1, "key": "example_cycle", "type": "cycle", "title": "По ту сторону", "description": "Цикл историй.", "completionStatus": "in_development", "items": [{"target": {"kind": "collection", "key": "example_volume"}}], "transitions": []},
    {"schemaVersion": 1, "key": "example_catalog", "type": "catalog", "title": "Фантастика", "description": "Пример тематического каталога.", "completionStatus": "in_development", "items": [{"target": {"kind": "collection", "key": "example_cycle"}}], "transitions": []}
