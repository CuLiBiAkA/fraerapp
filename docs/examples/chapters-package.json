        "schemaVersion": 1,
        "inputContract": {"version": 1, "allowIndependentStart": false, "fields": [
          {"name": "initialCourage", "type": "number", "required": true, "min": 0, "max": 10},
          {"name": "metAlly", "type": "boolean", "required": false, "defaultValue": false}
        ]},
        "relations": [{"id": "visit_keeper", "type": "sequel", "target": {"kind": "scenario", "key": "example_keeper"}, "label": "Прочитать историю смотрителя", "stateTransfer": {"mode": "independent"}}]
      },
      "scenes": [{"id": "start", "title": "В купе", "text": "Смелость: {{initialCourage}}. Вы помогли проводнику: {{metAlly}}.", "ending": {"type": "ending", "title": "Ночь начинается"}, "choices": []}]
    },
    {
      "key": "example_keeper", "title": "Смотритель", "description": "Самостоятельная история с независимым началом.",
      "version": 1, "completionStatus": "completed", "startSceneId": "start", "variables": {}, "assets": [],
      "scenes": [{"id": "start", "title": "На станции", "text": "Смотритель закрывает двери пустого вокзала.", "ending": {"type": "ending", "title": "До завтра"}, "choices": []}]
    }
  ],
  "collections": [
    {
      "schemaVersion": 1, "key": "example_train", "type": "story", "title": "Ночной поезд", "description": "Две главы одного прохождения.", "completionStatus": "completed",
