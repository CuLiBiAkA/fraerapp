      "version": 1, "completionStatus": "completed", "startSceneId": "start",
      "variables": {"courage": {"value": 1, "showInStats": true}, "helpedConductor": false}, "assets": [],
      "scenes": [
        {"id": "start", "title": "На платформе", "text": "Проводник просит помочь с чемоданом.", "choices": [
          {"id": "help", "label": "Помочь", "target": "end", "effects": [{"inc": "courage", "value": 2}, {"set": "helpedConductor", "value": true}]},
          {"id": "pass", "label": "Пройти в вагон", "target": "end"}
        ]},
        {"id": "end", "title": "Билет получен", "text": "Поезд отправляется.", "ending": {"type": "ending", "title": "В путь"}, "choices": []}
      ]
    },
    {
      "key": "example_carriage", "title": "Вагон", "description": "Вторая глава получает только выбранные параметры.",
      "version": 1, "completionStatus": "completed", "startSceneId": "start",
      "variables": {"initialCourage": {"value": 0, "showInStats": true}, "metAlly": false}, "assets": [],
